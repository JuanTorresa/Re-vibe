```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Re-Vibe Studio - Customización & Upcycling de Ropa Usada</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Fabric.js para manipulaciones interactivas robustas del Canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Montserrat:wght@400;600;700;800;900&family=Permanent+Marker&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            green: '#1E3E2B',
                            accent: '#A3E635',
                            denim: '#2563EB',
                            dark: '#0F172A',
                            sand: '#F8F6F0',
                            card: '#FFFFFF',
                            rust: '#E11D48'
                        }
                    },
                    fontFamily: {
                        sans: ['Montserrat', 'sans-serif'],
                        graffiti: ['Permanent Marker', 'cursive'],
                        script: ['Caveat', 'cursive'],
                        mono: ['Space Grotesk', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #E2E8F0;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #A3E635;
            border-radius: 8px;
        }
        /* Ajuste de controles de Fabric.js */
        .canvas-container {
            margin: 0 auto !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
            border-radius: 1rem;
            overflow: hidden;
            background: #ffffff;
        }
    </style>
</head>
<body class="bg-brand-sand text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-stone-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-brand-dark text-brand-accent p-2.5 rounded-xl shadow-md border border-brand-accent/30 flex items-center justify-center">
                    <i class="fa-solid fa-arrows-rotate text-xl animate-spin-slow"></i>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h1 class="font-extrabold text-lg sm:text-2xl tracking-tighter text-brand-dark font-mono leading-none">
                            RE-VIBE<span class="text-brand-accent">.</span>
                        </h1>
                        <span class="bg-brand-accent/20 text-brand-green text-[10px] font-black px-1.5 py-0.5 rounded uppercase tracking-wider">Studio</span>
                    </div>
                    <p class="text-[11px] text-stone-500 font-medium">Reutiliza. Rediseña. Dale otra vibra a tu ropa.</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-4">
                <!-- Selector de Moneda -->
                <div class="flex items-center bg-stone-100 rounded-xl px-2 py-1 text-xs font-bold text-stone-700 border border-stone-200">
                    <i class="fa-solid fa-coins text-brand-green mr-1.5"></i>
                    <select id="currency-select" onchange="changeCurrency()" class="bg-transparent focus:outline-none cursor-pointer">
                        <option value="COP">COP ($)</option>
                        <option value="USD">USD ($)</option>
                        <option value="MXN">MXN ($)</option>
                        <option value="EUR">EUR (€)</option>
                    </select>
                </div>

                <!-- Botón Cotización / Carrito -->
                <button onclick="toggleModal('summary-modal')" class="flex items-center gap-2 bg-brand-dark hover:bg-black text-white px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold shadow-md transition border border-stone-800">
                    <i class="fa-solid fa-bag-shopping text-brand-accent"></i>
                    <span class="hidden sm:inline">Mi Re-Vibe</span>
                    <span id="cart-badge" class="bg-brand-accent text-brand-dark px-1.5 py-0.5 rounded-full text-xs font-black">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Layout -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- PANEL IZQUIERDO: Selector de Prenda y Herramientas (5 Col) -->
        <aside class="lg:col-span-5 flex flex-col gap-4">
            
            <!-- STEP 1: Prenda Base y Color -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-200">
                <h2 class="text-xs uppercase tracking-wider font-extrabold text-brand-dark mb-3 flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-brand-dark text-brand-accent flex items-center justify-center text-[10px] font-mono font-bold">1</span>
                        Selecciona tu prenda base
                    </span>
                    <span class="text-[11px] font-normal text-stone-400">Piesas Re-Vibe Usadas</span>
                </h2>

                <!-- Grid de Prendas Base -->
                <div class="grid grid-cols-2 gap-2" id="garment-selector">
                    <button onclick="selectGarment('jacket')" id="btn-garment-jacket" class="garment-btn border-2 border-brand-dark bg-stone-50 p-2.5 rounded-xl flex items-center gap-3 transition text-left">
                        <div class="w-10 h-10 rounded-lg bg-stone-200 flex items-center justify-center text-brand-dark font-bold text-lg"><i class="fa-solid fa-vest"></i></div>
                        <div>
                            <p class="font-bold text-xs text-stone-800">Chaqueta Denim</p>
                            <p class="text-[11px] text-stone-500 font-semibold" id="price-tag-jacket">$25 USD</p>
                        </div>
                    </button>

                    <button onclick="selectGarment('tshirt')" id="btn-garment-tshirt" class="garment-btn border-2 border-stone-200 p-2.5 rounded-xl flex items-center gap-3 transition text-left">
                        <div class="w-10 h-10 rounded-lg bg-stone-100 flex items-center justify-center text-stone-600 text-lg"><i class="fa-solid fa-shirt"></i></div>
                        <div>
                            <p class="font-bold text-xs text-stone-800">Camiseta Algodón</p>
                            <p class="text-[11px] text-stone-500 font-semibold" id="price-tag-tshirt">$12 USD</p>
                        </div>
                    </button>

                    <button onclick="selectGarment('pants')" id="btn-garment-pants" class="garment-btn border-2 border-stone-200 p-2.5 rounded-xl flex items-center gap-3 transition text-left">
                        <div class="w-10 h-10 rounded-lg bg-stone-100 flex items-center justify-center text-stone-600 text-lg"><i class="fa-solid fa-socks"></i></div>
                        <div>
                            <p class="font-bold text-xs text-stone-800">Jeans / Pantalón</p>
                            <p class="text-[11px] text-stone-500 font-semibold" id="price-tag-pants">$22 USD</p>
                        </div>
                    </button>

                    <button onclick="selectGarment('hoodie')" id="btn-garment-hoodie" class="garment-btn border-2 border-stone-200 p-2.5 rounded-xl flex items-center gap-3 transition text-left">
                        <div class="w-10 h-10 rounded-lg bg-stone-100 flex items-center justify-center text-stone-600 text-lg"><i class="fa-solid fa-user-ninja"></i></div>
                        <div>
                            <p class="font-bold text-xs text-stone-800">Hoodie Sudadera</p>
                            <p class="text-[11px] text-stone-500 font-semibold" id="price-tag-hoodie">$28 USD</p>
                        </div>
                    </button>
                </div>

                <!-- Selector de Color de Prenda -->
                <div class="mt-3 pt-3 border-t border-stone-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-stone-600">Color Base:</span>
                    <div class="flex items-center gap-1.5" id="color-palette">
                        <button onclick="changeGarmentColor('#3B5998')" class="w-6 h-6 rounded-full bg-[#3B5998] border-2 border-white shadow hover:scale-110 transition" title="Denim Clásico"></button>
                        <button onclick="changeGarmentColor('#0F172A')" class="w-6 h-6 rounded-full bg-[#0F172A] border-2 border-white shadow hover:scale-110 transition" title="Negro Re-Vibe"></button>
                        <button onclick="changeGarmentColor('#F4F1EA')" class="w-6 h-6 rounded-full bg-[#F4F1EA] border border-stone-300 shadow hover:scale-110 transition" title="Crudo Vintage"></button>
                        <button onclick="changeGarmentColor('#1E3E2B')" class="w-6 h-6 rounded-full bg-[#1E3E2B] border-2 border-white shadow hover:scale-110 transition" title="Verde Botella"></button>
                        <button onclick="changeGarmentColor('#E11D48')" class="w-6 h-6 rounded-full bg-[#E11D48] border-2 border-white shadow hover:scale-110 transition" title="Rojo Vibe"></button>
                        <input type="color" id="custom-garment-color" onchange="changeGarmentColor(this.value)" class="w-6 h-6 rounded-full cursor-pointer p-0 border-0 bg-transparent" title="Color Personalizado">
                    </div>
                </div>
            </div>

            <!-- STEP 2: Herramientas de Personalización -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-200 flex-1 flex flex-col">
                <h2 class="text-xs uppercase tracking-wider font-extrabold text-brand-dark mb-3 flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full bg-brand-dark text-brand-accent flex items-center justify-center text-[10px] font-mono font-bold">2</span>
                    Personaliza & Re-Vibra
                </h2>

                <!-- Pestana de Modos -->
                <div class="flex border-b border-stone-200 mb-3 text-xs overflow-x-auto custom-scrollbar gap-1 pb-1">
                    <button onclick="switchTab('stickers')" id="tab-btn-stickers" class="tab-btn active font-bold py-1.5 px-2.5 border-b-2 border-brand-dark text-brand-dark whitespace-nowrap">
                        <i class="fa-solid fa-icons mr-1"></i> Parches
                    </button>
                    <button onclick="switchTab('upload')" id="tab-btn-upload" class="tab-btn font-bold py-1.5 px-2.5 text-stone-500 hover:text-stone-800 whitespace-nowrap">
                        <i class="fa-solid fa-upload mr-1"></i> Subir Arte
                    </button>
                    <button onclick="switchTab('text')" id="tab-btn-text" class="tab-btn font-bold py-1.5 px-2.5 text-stone-500 hover:text-stone-800 whitespace-nowrap">
                        <i class="fa-solid fa-font mr-1"></i> Texto / Bordado
                    </button>
                    <button onclick="switchTab('distress')" id="tab-btn-distress" class="tab-btn font-bold py-1.5 px-2.5 text-stone-500 hover:text-stone-800 whitespace-nowrap">
                        <i class="fa-solid fa-scissors mr-1"></i> Desgaste / Herrajes
                    </button>
                </div>

                <!-- CONTENIDO PESTAÑA 1: Parches Predeterminados -->
                <div id="tab-stickers" class="tab-content flex-1">
                    <p class="text-[11px] text-stone-500 mb-2">Añade parches exclusivos Re-Vibe (+$3 USD c/u):</p>
                    <div class="grid grid-cols-4 gap-2 max-h-52 overflow-y-auto custom-scrollbar p-1">
                        <button onclick="addPresetSticker('🌱', 'Re-Vibe Green')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🌱</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Green Brote</span>
                        </button>
                        <button onclick="addPresetSticker('♻️', 'Recycle Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">♻️</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Reciclaje</span>
                        </button>
                        <button onclick="addPresetSticker('⚡', 'Rayo Re-Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">⚡</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Voltio</span>
                        </button>
                        <button onclick="addPresetSticker('🔥', 'Fire Upcycling')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🔥</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Fuego</span>
                        </button>
                        <button onclick="addPresetSticker('💀', 'Skull Re-Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">💀</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Calavera</span>
                        </button>
                        <button onclick="addPresetSticker('🌸', 'Flower Power')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🌸</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Flor</span>
                        </button>
                        <button onclick="addPresetSticker('🛸', 'UFO Re-Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🛸</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Alien</span>
                        </button>
                        <button onclick="addPresetSticker('☮️', 'Peace Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">☮️</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Paz</span>
                        </button>
                        <button onclick="addPresetSticker('🇨🇴', 'Vibe Colombia')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🇨🇴</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Bandera</span>
                        </button>
                        <button onclick="addPresetSticker('🦋', 'Butterfly Vibe')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🦋</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Mariposa</span>
                        </button>
                        <button onclick="addPresetSticker('🍄', 'Mushroom Street')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">🍄</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Hongo</span>
                        </button>
                        <button onclick="addPresetSticker('⭐', 'Star Upcycle')" class="p-2 border border-stone-200 rounded-xl hover:bg-lime-50 hover:border-brand-accent transition flex flex-col items-center">
                            <span class="text-2xl">⭐</span>
                            <span class="text-[9px] font-semibold text-stone-600 mt-1">Estrella</span>
                        </button>
                    </div>
                </div>

                <!-- CONTENIDO PESTAÑA 2: Cargar Imagen Propia -->
                <div id="tab-upload" class="tab-content hidden flex-1 flex-col justify-center">
                    <div class="border-2 border-dashed border-stone-300 rounded-xl p-4 text-center hover:border-brand-dark transition bg-stone-50">
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-brand-dark mb-2"></i>
                        <p class="text-xs font-bold text-stone-700">Subir diseño o logo propio a Re-Vibe</p>
                        <p class="text-[10px] text-stone-400 mb-3">Soporta PNG, JPG o SVG (Máx 5MB)</p>
                        <label class="bg-brand-dark text-white text-xs font-bold px-3.5 py-2 rounded-xl cursor-pointer hover:bg-black transition shadow">
                            Explorar Archivos
                            <input type="file" id="image-upload-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                        </label>
                    </div>
                    <p class="text-[10px] text-stone-400 text-center mt-2">Costo por parche personalizado: +$3 USD</p>
                </div>

                <!-- CONTENIDO PESTAÑA 3: Texto Personalizado -->
                <div id="tab-text" class="tab-content hidden flex-1 flex-col gap-2.5">
                    <div>
                        <label class="block text-[11px] font-semibold text-stone-600 mb-1">Texto o Frase Re-Vibe:</label>
                        <input type="text" id="custom-text-input" placeholder="Ej: RE-VIBE YOUR STYLE" class="w-full px-3 py-1.5 border border-stone-300 rounded-xl text-xs focus:ring-1 focus:ring-brand-dark outline-none">
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Tipografía:</label>
                            <select id="text-font-family" class="w-full px-2 py-1.5 border border-stone-300 rounded-xl text-xs bg-white">
                                <option value="Permanent Marker">Graffiti Urbano</option>
                                <option value="Space Grotesk">Tech Re-Vibe</option>
                                <option value="Caveat">Bordado Cursiva</option>
                                <option value="Montserrat">Sans-Serif Limpio</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Color Hilo/Pintura:</label>
                            <input type="color" id="text-color-picker" value="#A3E635" class="w-full h-8 p-0.5 border border-stone-300 rounded-xl cursor-pointer">
                        </div>
                    </div>

                    <button onclick="addCustomText()" class="w-full bg-brand-dark text-white font-bold py-2 rounded-xl text-xs hover:bg-black transition shadow mt-1">
                        + Añadir Texto Re-Vibe (+$4 USD)
                    </button>
                </div>

                <!-- CONTENIDO PESTAÑA 4: Desgaste y Remaches -->
                <div id="tab-distress" class="tab-content hidden flex-1">
                    <p class="text-[11px] text-stone-500 mb-2">Efectos especiales de desgaste y herrajes (+$2 USD c/u):</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="addDistressEffect('rip')" class="p-2.5 border border-stone-200 rounded-xl hover:border-brand-accent flex items-center gap-2 text-left">
                            <span class="text-xl">✂️</span>
                            <div>
                                <p class="text-xs font-bold text-stone-800">Corte/Rotura</p>
                                <p class="text-[10px] text-stone-500">Ripped Urban</p>
                            </div>
                        </button>

                        <button onclick="addDistressEffect('stud')" class="p-2.5 border border-stone-200 rounded-xl hover:border-brand-accent flex items-center gap-2 text-left">
                            <span class="text-xl">🔘</span>
                            <div>
                                <p class="text-xs font-bold text-stone-800">Tachuela Metal</p>
                                <p class="text-[10px] text-stone-500">Remache Pirámide</p>
                            </div>
                        </button>

                        <button onclick="addDistressEffect('pin')" class="p-2.5 border border-stone-200 rounded-xl hover:border-brand-accent flex items-center gap-2 text-left">
                            <span class="text-xl">🧷</span>
                            <div>
                                <p class="text-xs font-bold text-stone-800">Gancho / Pin</p>
                                <p class="text-[10px] text-stone-500">Imperdible Punk</p>
                            </div>
                        </button>

                        <button onclick="addDistressEffect('patch_hole')" class="p-2.5 border border-stone-200 rounded-xl hover:border-brand-accent flex items-center gap-2 text-left">
                            <span class="text-xl">🕳️</span>
                            <div>
                                <p class="text-xs font-bold text-stone-800">Desgaste Circular</p>
                                <p class="text-[10px] text-stone-500">Parche de Tela</p>
                            </div>
                        </button>
                    </div>
                </div>

            </div>

        </aside>

        <!-- PANEL DERECHO: Canvas Interactivo y Controladores (7 Col) -->
        <section class="lg:col-span-7 flex flex-col gap-4">
            
            <!-- Lienzo Interactivo -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-stone-200 flex flex-col items-center relative">
                
                <div class="w-full flex justify-between items-center mb-3">
                    <span class="text-xs font-bold text-stone-700 flex items-center gap-1.5 font-mono uppercase tracking-wider">
                        <i class="fa-solid fa-wand-magic-sparkles text-brand-dark"></i>
                        Estudio de Diseño Re-Vibe
                    </span>
                    <span class="text-[11px] text-stone-400">Arrastra, escala y rota los elementos</span>
                </div>

                <!-- Contenedor del Canvas de Fabric.js -->
                <div class="relative rounded-xl overflow-hidden border border-stone-200 shadow-inner bg-stone-50">
                    <canvas id="garment-canvas" width="460" height="460"></canvas>
                </div>

                <!-- Barra de Herramientas del Objeto Seleccionado -->
                <div class="w-full mt-3 pt-3 border-t border-stone-100 flex flex-wrap items-center justify-between gap-2">
                    <span class="text-[11px] font-bold text-stone-500">Controles de Selección:</span>
                    
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <button onclick="centerObject('horizontal')" title="Centrar Horizontalmente" class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 rounded-lg text-xs text-stone-700 font-semibold">
                            <i class="fa-solid fa-arrows-left-right"></i>
                        </button>
                        <button onclick="duplicateSelected()" title="Duplicar Objeto" class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 rounded-lg text-xs text-stone-700 font-semibold">
                            <i class="fa-solid fa-copy"></i>
                        </button>
                        <button onclick="bringToFront()" title="Traer al frente" class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 rounded-lg text-xs text-stone-700 font-semibold">
                            <i class="fa-solid fa-layer-group"></i>
                        </button>
                        <button onclick="sendToBack()" title="Enviar al fondo" class="px-2.5 py-1 bg-stone-100 hover:bg-stone-200 rounded-lg text-xs text-stone-700 font-semibold">
                            <i class="fa-solid fa-down-left-and-up-right-to-center"></i>
                        </button>
                        <button onclick="deleteSelected()" title="Eliminar seleccionado" class="px-2.5 py-1 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-xs font-bold">
                            <i class="fa-solid fa-trash mr-1"></i> Borrar
                        </button>
                        <button onclick="clearCanvas()" title="Reiniciar todo" class="px-2.5 py-1 border border-stone-200 hover:border-red-300 rounded-lg text-xs text-stone-500 hover:text-red-600 transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Reiniciar
                        </button>
                    </div>
                </div>

            </div>

            <!-- Calculadora de Sostenibilidad y Presupuesto -->
            <div class="bg-brand-dark text-white p-5 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 border border-stone-800">
                
                <!-- Métricas Verdes -->
                <div class="space-y-1 text-center sm:text-left">
                    <div class="flex items-center justify-center sm:justify-start gap-2">
                        <i class="fa-solid fa-leaf text-brand-accent"></i>
                        <h3 class="font-extrabold text-xs uppercase tracking-widest text-stone-300 font-mono">Impacto Re-Vibe Sostenible</h3>
                    </div>
