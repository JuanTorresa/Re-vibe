    <!-- SCRIPT DE LÓGICA COMPLETA -->
    <script>
        // --- BASE DE DATOS DE PRENDAS Y TASAS ---
        const garmentsConfig = {
            jacket: { name: 'Chaqueta Denim Re-Vibe', baseUSD: 25, water: 3500, co2: 12.5, waste: 650, svgPath: 'M120 100 L180 80 L250 110 L320 80 L380 100 L440 180 L380 220 L370 420 L130 420 L120 220 L60 180 Z' },
            tshirt: { name: 'Camiseta Algodón Re-Vibe', baseUSD: 12, water: 2700, co2: 7.0, waste: 250, svgPath: 'M150 100 Q250 150 350 100 L430 160 L370 240 L350 210 L350 430 L150 430 L150 210 L130 240 L70 160 Z' },
            pants: { name: 'Jeans Pantalón Re-Vibe', baseUSD: 22, water: 3000, co2: 10.0, waste: 500, svgPath: 'M140 80 L360 80 L380 440 L260 440 L250 200 L240 440 L120 440 Z' },
            hoodie: { name: 'Hoodie Sudadera Re-Vibe', baseUSD: 28, water: 3200, co2: 11.0, waste: 600, svgPath: 'M150 110 Q250 60 350 110 L440 190 L380 260 L360 220 L360 430 L140 430 L140 220 L120 260 L60 190 Z' }
        };

        const exchangeRates = {
            COP: { symbol: '$', rate: 4000.0, label: 'COP' },
            USD: { symbol: '$', rate: 1.0, label: 'USD' },
            MXN: { symbol: '$', rate: 18.0, label: 'MXN' },
            EUR: { symbol: '€', rate: 0.92, label: 'EUR' }
        };

        // --- ESTADO GLOBAL ---
        let canvas;
        let selectedGarmentKey = 'jacket';
        let currentGarmentColor = '#3B5998';
        let currentCurrency = 'COP';
        let customElementsList = [];

        // --- INICIALIZACIÓN DE LA APP ---
        window.onload = function() {
            canvas = new fabric.Canvas('garment-canvas', {
                selection: true,
                preserveObjectStacking: true
            });

            updateGarmentBackground();
            updateAllPrices();

            canvas.on('object:added', refreshBudget);
            canvas.on('object:removed', refreshBudget);
        };

        // --- SILUETAS Y FONDO EN CANVA ---
        function updateGarmentBackground() {
            const garment = garmentsConfig[selectedGarmentKey];

            const svgRaw = `
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500">
                    <rect width="500" height="500" fill="#F8FAFC"/>
                    <path d="${garment.svgPath}" fill="${currentGarmentColor}" stroke="#0F172A" stroke-width="8" stroke-linejoin="round"/>
                </svg>
            `;

            fabric.loadSVGFromString(svgRaw, function(objects, options) {
                const loadedObject = fabric.util.groupSVGElements(objects, options);
                loadedObject.set({
                    scaleX: canvas.width / 500,
                    scaleY: canvas.height / 500,
                    selectable: false,
                    evented: false,
                    left: 0,
                    top: 0
                });

                canvas.setBackgroundImage(loadedObject, canvas.renderAll.bind(canvas));
            });
        }

        // --- SELECCIÓN DE PRENDA BASE Y COLOR ---
        function selectGarment(key) {
            selectedGarmentKey = key;

            document.querySelectorAll('.garment-btn').forEach(btn => {
                btn.classList.remove('border-brand-dark', 'bg-stone-50');
                btn.classList.add('border-stone-200');
            });

            const activeBtn = document.getElementById(`btn-garment-${key}`);
            if (activeBtn) {
                activeBtn.classList.add('border-brand-dark', 'bg-stone-50');
                activeBtn.classList.remove('border-stone-200');
            }

            updateGarmentBackground();
            refreshBudget();
        }

        function changeGarmentColor(colorHex) {
            currentGarmentColor = colorHex;
            updateGarmentBackground();
        }

        // --- HERRAMIENTAS DE PERSONALIZACIÓN ---

        function addPresetSticker(emoji, name) {
            const textObj = new fabric.Text(emoji, {
                left: 180 + (Math.random() * 30 - 15),
                top: 180 + (Math.random() * 30 - 15),
                fontSize: 55,
                cornerColor: '#0F172A',
                cornerSize: 8,
                transparentCorners: false
            });

            textObj.customData = { id: Date.now(), type: 'Parche Re-Vibe', name: name, costUSD: 3.0 };

            canvas.add(textObj);
            canvas.setActiveObject(textObj);
            refreshBudget();
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                fabric.Image.fromURL(e.target.result, function(img) {
                    img.scaleToWidth(100);
                    img.set({
                        left: 180,
                        top: 180,
                        cornerColor: '#0F172A',
                        cornerSize: 8,
                        transparentCorners: false
                    });

                    img.customData = { id: Date.now(), type: 'Arte Personalizado', name: file.name.substring(0, 15), costUSD: 3.0 };

                    canvas.add(img);
                    canvas.setActiveObject(img);
                    refreshBudget();
                });
            };
            reader.readAsDataURL(file);
        }

        function addCustomText() {
            const input = document.getElementById('custom-text-input');
            const font = document.getElementById('text-font-family').value;
            const color = document.getElementById('text-color-picker').value;
            const textVal = input.value.trim() || 'RE-VIBE';

            const textObj = new fabric.Text(textVal, {
                left: 150,
                top: 200,
                fontFamily: font,
                fill: color,
                fontSize: 32,
                cornerColor: '#0F172A',
                cornerSize: 8,
                transparentCorners: false
            });

            textObj.customData = { id: Date.now(), type: 'Bordado/Texto', name: `"${textVal}"`, costUSD: 4.0 };

            canvas.add(textObj);
            canvas.setActiveObject(textObj);
            refreshBudget();
            input.value = '';
        }

        function addDistressEffect(type) {
            let fabricObj;
            let name = 'Efecto Re-Vibe';

            if (type === 'rip') {
                name = 'Corte Ripped';
                fabricObj = new fabric.Rect({
                    left: 180, top: 200, width: 80, height: 10,
                    fill: '#E2E8F0', stroke: '#0F172A', strokeWidth: 1.5, rx: 3, ry: 3
                });
            } else if (type === 'stud') {
                name = 'Tachuela Metal';
                fabricObj = new fabric.Circle({
                    left: 200, top: 200, radius: 12, fill: '#94A3B8', stroke: '#0F172A', strokeWidth: 2
                });
            } else if (type === 'pin') {
                name = 'Gancho Imperdible';
                fabricObj = new fabric.Text('🧷', { left: 200, top: 200, fontSize: 40 });
            } else {
                name = 'Parche Tela Usada';
                fabricObj = new fabric.Circle({
                    left: 190, top: 190, radius: 25, fill: '#CBD5E1', stroke: '#0F172A', strokeWidth: 2, strokeDashArray: [4, 4]
                });
            }

            fabricObj.set({ cornerColor: '#0F172A', cornerSize: 8, transparentCorners: false });
            fabricObj.customData = { id: Date.now(), type: 'Efecto/Herraje', name: name, costUSD: 2.0 };

            canvas.add(fabricObj);
            canvas.setActiveObject(fabricObj);
            refreshBudget();
        }

        // --- MANIPULACIÓN EN LIENZO ---
        function deleteSelected() {
            const activeObj = canvas.getActiveObject();
            if (activeObj) {
                canvas.remove(activeObj);
                canvas.discardActiveObject();
                refreshBudget();
            }
        }

        function duplicateSelected() {
            const activeObj = canvas.getActiveObject();
            if (activeObj) {
                activeObj.clone(function(cloned) {
                    cloned.set({
                        left: activeObj.left + 15,
                        top: activeObj.top + 15,
                        cornerColor: '#0F172A'
                    });
                    if (activeObj.customData) {
                        cloned.customData = { ...activeObj.customData, id: Date.now() };
                    }
                    canvas.add(cloned);
                    canvas.setActiveObject(cloned);
                    refreshBudget();
                });
            }
        }

        function centerObject(axis) {
            const activeObj = canvas.getActiveObject();
            if (activeObj) {
                if (axis === 'horizontal') activeObj.centerH();
                canvas.renderAll();
            }
        }

        function bringToFront() {
            const activeObj = canvas.getActiveObject();
            if (activeObj) {
                activeObj.bringToFront();
                canvas.renderAll();
            }
        }

        function sendToBack() {
            const activeObj = canvas.getActiveObject();
            if (activeObj) {
                activeObj.sendToBack();
                canvas.renderAll();
            }
        }

        function clearCanvas() {
            const objects = canvas.getObjects();
            objects.forEach(obj => canvas.remove(obj));
            refreshBudget();
        }

        // --- SISTEMA DE MONEDA Y PRESUPUESTO ---
        function changeCurrency() {
            currentCurrency = document.getElementById('currency-select').value;
            updateAllPrices();
            refreshBudget();
        }

        function formatPrice(valUSD) {
            const curr = exchangeRates[currentCurrency];
            const converted = valUSD * curr.rate;
            if (currentCurrency === 'COP') {
                return `${curr.symbol}${Math.round(converted).toLocaleString('es-CO')}`;
            }
            return `${curr.symbol}${converted.toFixed(2)}`;
        }

        function updateAllPrices() {
            document.getElementById('price-tag-jacket').innerText = formatPrice(garmentsConfig.jacket.baseUSD);
            document.getElementById('price-tag-tshirt').innerText = formatPrice(garmentsConfig.tshirt.baseUSD);
            document.getElementById('price-tag-pants').innerText = formatPrice(garmentsConfig.pants.baseUSD);
            document.getElementById('price-tag-hoodie').innerText = formatPrice(garmentsConfig.hoodie.baseUSD);
        }

        function refreshBudget() {
            const currentGarment = garmentsConfig[selectedGarmentKey];
            let totalUSD = currentGarment.baseUSD;
            const itemsOnCanvas = [];

            canvas.getObjects().forEach(obj => {
                if (obj.customData) {
                    totalUSD += obj.customData.costUSD;
                    itemsOnCanvas.push(obj.customData);
                }
            });

            document.getElementById('total-price-display').innerText = `${formatPrice(totalUSD)} ${currentCurrency}`;
            document.getElementById('cart-badge').innerText = itemsOnCanvas.length + 1;

            document.getElementById('metric-water').innerText = `${currentGarment.water.toLocaleString()} L`;
            document.getElementById('metric-co2').innerText = `${currentGarment.co2} kg`;
            document.getElementById('metric-waste').innerText = `${currentGarment.waste} g`;

            const breakdownEl = document.getElementById('modal-items-breakdown');
            breakdownEl.innerHTML = `
                <div class="flex justify-between font-bold text-stone-800 border-b border-stone-200 pb-1">
                    <span>${currentGarment.name}</span>
                    <span>${formatPrice(currentGarment.baseUSD)}</span>
                </div>
            `;

            itemsOnCanvas.forEach(item => {
                breakdownEl.innerHTML += `
                    <div class="flex justify-between text-stone-600">
                        <span>+ ${item.type}: ${item.name}</span>
                        <span class="font-semibold">${formatPrice(item.costUSD)}</span>
                    </div>
                `;
            });

            breakdownEl.innerHTML += `
                <div class="flex justify-between font-extrabold text-brand-dark pt-2 border-t border-stone-200 text-sm">
                    <span>Total Re-Vibe:</span>
                    <span class="text-emerald-700">${formatPrice(totalUSD)} ${currentCurrency}</span>
                </div>
            `;
        }

        // --- PESTAÑAS Y MODALES ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('border-b-2', 'border-brand-dark', 'text-brand-dark', 'active');
                el.classList.add('text-stone-500');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-btn-${tabId}`);
            btn.classList.add('border-b-2', 'border-brand-dark', 'text-brand-dark', 'active');
            btn.classList.remove('text-stone-500');
        }

        function toggleModal(modalId) {
            document.getElementById(modalId).classList.toggle('hidden');
        }

        // --- EXPORTACIÓN Y WHATSAPP ---
        function downloadDesignPNG() {
            canvas.discardActiveObject();
            canvas.renderAll();

            const dataURL = canvas.toDataURL({
                format: 'png',
                quality: 1.0,
                multiplier: 2
            });

            const link = document.createElement('a');
            link.download = `ReVibe_Studio_Design_${Date.now()}.png`;
            link.href = dataURL;
            link.click();
        }

        function sendOrderWhatsApp() {
            const name = document.getElementById('client-name').value.trim();
            const phone = document.getElementById('client-phone').value.trim() || '573000000000';
            const notes = document.getElementById('client-notes').value.trim();

            if (!name) {
                alert('Por favor ingresa tu nombre.');
                return;
            }

            const currentGarment = garmentsConfig[selectedGarmentKey];
            let msg = `*¡Hola RE-VIBE Studio! Deseo cotizar mi prenda de upcycling* ⚡♻️\n\n`;
            msg += `👤 *Cliente:* ${name}\n`;
            msg += `👕 *Prenda Base:* ${currentGarment.name}\n`;
            msg += `🎨 *Elementos personalizados:* ${document.getElementById('cart-badge').innerText - 1} elementos\n`;
            msg += `💰 *Total Estimado:* ${document.getElementById('total-price-display').innerText}\n`;
            if (notes) msg += `📝 *Notas / Talla:* ${notes}\n`;

            const encodedMsg = encodeURIComponent(msg);
            window.open(`https://wa.me/${phone.replace(/[^0-9]/g, '')}?text=${encodedMsg}`, '_blank');
        }
    </script>
